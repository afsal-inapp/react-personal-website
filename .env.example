# Optional. If set, product enquiry forms POST JSON to this URL
# (e.g. a Formspree, Basin, or your own serverless endpoint).
# If unset, forms fall back to opening a pre-filled email.
VITE_FORM_ENDPOINT=

# Optional. Absolute site origin used in Open Graph tags (e.g. https://afsal.dev).
# On Vercel this defaults to the project's production URL automatically.
VITE_SITE_URL=
